# VITE_FIREBASE_*  — kredensial Firebase WEB (client SDK), bukan service account.
# Semua variabel ini bersifat publik-to-client; keamanan ditangani Firebase Security Rules.
# Tanpa file/.env ini, frontend tetap jalan memakai auth email/password dari REST API backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
