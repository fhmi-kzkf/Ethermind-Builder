{
  "name": "__PACKAGE_NAME__",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma db push --skip-generate && node prisma/seed.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prisma": "5.22.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
