PORT=4000
NODE_ENV=development
JWT_SECRET=ethermind_secure_jwt_secret_key_prod_grade_2026_xyz
JWT_EXPIRES_IN=7d
DATABASE_URL="file:./dev.db"

# ==========================================
# NVIDIA NIM CONFIGURATION (Inference Microservice)
# ==========================================
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=""

OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=""

# ==========================================
# 5-MODEL CODING PIPELINE
# ==========================================
MODEL_PLANNER=nvidia/nemotron-3-super-120b-a12b
MODEL_ORCHESTRATOR=nvidia/nemotron-3-super-120b-a12b
MODEL_CODER=nvidia/nemotron-3-super-120b-a12b
MODEL_REVIEWER=nvidia/nemotron-3-ultra-550b-a55b
MODEL_FAST=poolside/laguna-xs-2.1
MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b
# Dicoba berurutan bila model utama timeout atau error. Harus ID yang benar-benar ada di endpoint (cek GET /v1/models).
MODEL_FALLBACKS=nvidia/nemotron-3-super-120b-a12b,openai/gpt-oss-20b,poolside/laguna-xs-2.1
# Model yang tidak mengirim token pertama dalam batas ini dianggap mati dan diganti model berikutnya.
LLM_FIRST_TOKEN_TIMEOUT_MS=30000
LLM_FAST_FIRST_TOKEN_TIMEOUT_MS=15000
LLM_IDLE_TIMEOUT_MS=45000
# Panggilan model untuk build yang boleh berjalan bersamaan (semua job). Turunkan bila provider sering 503/429.
LLM_MAX_CONCURRENT=6

# Aturan kualitas (anti-slop, frontend, backend, dll) yang ditambahkan ke prompt agent.
# Set false untuk membandingkan hasil dengan/tanpa skill. Isi file ada di ./skills
SKILLS_ENABLED=true

# Tombol "Akun Demo Cepat" di UI. Aktif otomatis hanya saat NODE_ENV=development; server produksi menolak start bila true.
# DEMO_LOGIN=false

MAX_CONCURRENT_JOBS=3
DEFAULT_TOKEN_BUDGET=250000
DEFAULT_MAX_STEPS=30
STEP_TIMEOUT_MS=120000

STORAGE_DIR=./storage
WORKSPACES_DIR=./storage/workspaces
EXPORTS_DIR=./storage/exports
PREVIEW_PORT_START=5100
PREVIEW_PORT_END=5200

# ==========================================
# FIREBASE FIRESTORE & STORAGE CONFIGURATION
# ==========================================
# Opsi 1: File Service Account Key JSON
FIREBASE_SERVICE_ACCOUNT_KEY="./serviceAccountKey.json"

# Opsi 2: Environment variables langsung
FIREBASE_PROJECT_ID="ethermind-builder-prod"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@ethermind-builder-prod.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL="https://ethermind-builder-prod.firebaseio.com"
FIREBASE_STORAGE_BUCKET="ethermind-builder-prod.appspot.com"

# ==========================================
# GROQ (inferensi cepat) - opsional
# ==========================================
# Isi untuk memakai model "groq:..." (GPT-OSS 120B/20B, Qwen). Tanpa kunci, model Groq dilewati dan NIM dipakai.
GROQ_API_KEY=""
# free = 8K token/menit dan 200K token/hari (build tidak muat, otomatis pindah ke NIM; cukup untuk chat).
# developer = 250K token/menit. Salin angka persis akun Anda dari halaman Limits Groq bila berbeda.
GROQ_PLAN=free
# GROQ_RPM=
# GROQ_TPM=
# GROQ_RPD=
# GROQ_TPD=
# Batas panjang satu balasan di Groq dan effort reasoning gpt-oss (low lebih cepat, medium lebih teliti).
GROQ_MAX_OUTPUT_TOKENS=16000
GROQ_REASONING_EFFORT=medium
# Bila harus menunggu batas Groq lebih lama dari ini, panggilan dialihkan ke model berikutnya (NIM).
GROQ_MAX_QUEUE_MS=20000

# ==========================================
# GAMBAR ACUAN (screenshot atau sketsa di chat)
# ==========================================
# Model yang membaca gambar. Harus mendukung gambar; bawaannya Qwen 3.8 di Groq (status preview, bisa dihentikan Groq).
# Tanpa kunci Groq, fitur lampiran gambar nonaktif dan tombolnya tidak muncul.
# MODEL_VISION=groq:qwen/qwen3.8-27b
# MODEL_VISION_FALLBACKS=
VISION_MAX_IMAGES=3
VISION_MAX_BYTES=4000000
# Terukur: satu screenshot 1280x800 memakan sekitar 1.800 token prompt.
VISION_IMAGE_TOKENS=1800

# ANGKA DI LANDING PAGE
# Jumlah aplikasi selesai baru ditampilkan setelah mencapai angka ini. Di bawahnya, baris itu tidak muncul sama sekali.
PUBLIC_STATS_MIN=25

# PEMBAYARAN QRIS (unduh kode sumber)
# Isi dengan teks QRIS statis merchant: hasil membaca QR di folder merchant (diawali 000201, diakhiri 4 karakter checksum).
# Server mengubahnya menjadi QRIS dinamis per pesanan (nominal + kode unik 1-999). Kosong = unduhan kode gratis.
# Tidak ada callback dari bank: operator mengonfirmasi pembayaran dari menu Admin setelah dana terlihat di mutasi.
QRIS_STATIC=
PAYMENT_TTL_MINUTES=120

# ALAMAT APLIKASI, GERBANG, DAN LINK LIVE
# Domain tempat aplikasi klien hidup: pv-xxxx.<domain> (pratinjau) dan <nama>.<domain> (link live).
# Kosong = pratinjau memakai http://host:port dan link live nonaktif. Lihat docs/DEPLOYMENT.md bagian 5a dan deploy/Caddyfile.
# Lokal: APPS_DOMAIN=localhost, APPS_SCHEME=http, APPS_PUBLIC_PORT=4100 (peramban membuka *.localhost sebagai komputer sendiri).
APPS_DOMAIN=
# APPS_SCHEME=https
# APPS_PUBLIC_PORT=
GATEWAY_PORT=4100
# GATEWAY_HOST=127.0.0.1
PREVIEW_IDLE_MINUTES=20
LIVE_IDLE_MINUTES=120
WAKE_TIMEOUT_MS=25000
GATEWAY_RATE_LIMIT=300

# BATAS PER AKUN (operator dan admin dikecualikan)
MAX_PROJECTS_PER_USER=30
MAX_LIVE_APPS_PER_USER=3

# PERAWATAN HARIAN (cadangan dan pembersihan)
LIVE_DATA_DIR=./storage/live-data
BACKUP_DIR=./storage/backups
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=14
CLEANUP_ENABLED=true
CLEANUP_NODE_MODULES_DAYS=3
CLEANUP_FAILED_DAYS=14
CLEANUP_EXPORT_DAYS=7
